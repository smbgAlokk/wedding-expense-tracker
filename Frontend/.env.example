# Copy this file to .env and fill in the values.
# Vite exposes ONLY vars prefixed with VITE_ to the browser.

# Google OAuth Client ID (same value as the backend GOOGLE_CLIENT_ID).
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs.
VITE_GOOGLE_CLIENT_ID=

# API base URL for production builds, e.g. https://your-backend.up.railway.app/api
# Leave unset for local dev — the Vite proxy forwards /api to localhost:5000.
VITE_API_URL=
