# Copy this file to .env and fill in the values.
# Vite exposes ONLY vars prefixed with VITE_ to the browser.

# Google OAuth Client ID (same value as the backend GOOGLE_CLIENT_ID).
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs.
VITE_GOOGLE_CLIENT_ID=

# API base URL.
#
# C-2 cookie migration (§14.F): the session is an HttpOnly cookie, which only
# works first-party. The production deploy therefore proxies /api through Vercel
# to Railway (see vercel.json `rewrites`), making the API same-origin. So in
# production you should LEAVE THIS UNSET too — api.ts then uses the relative
# '/api', which Vercel proxies. Only set this to an absolute cross-origin URL if
# you deliberately abandon cookie auth (not supported by the current flow).
# Local dev: leave unset — the Vite proxy forwards /api to localhost:5000.
VITE_API_URL=

# ── Cloudflare Turnstile (H-8 CAPTCHA, §14.F) ──────────────────────────────
# Public site key. ENV-GATED: leave blank to hide the widget entirely (the
# backend gate is independently off unless TURNSTILE_SECRET is set). Pair this
# with the backend TURNSTILE_SECRET to enable CAPTCHA on signup/login/forgot.
VITE_TURNSTILE_SITE_KEY=

# ── Sentry (§14.G) ─────────────────────────────────────────────────────────
# DSN-GATED — leave blank to disable. @sentry/react is dynamically imported only
# when this is set, so there is zero bundle cost when unconfigured.
VITE_SENTRY_DSN=
