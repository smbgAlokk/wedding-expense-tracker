# Copy this file to .env and fill in the values.

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=

# JWT auth
JWT_SECRET=
JWT_EXPIRES_IN=30d

# Allowed frontend origin(s) for CORS. Comma-separated for multiple
# (e.g. production + Vercel preview URLs). Defaults to http://localhost:5173.
FRONTEND_URL=http://localhost:5173

# Cloudinary (receipt uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth Client ID (same value as the frontend VITE_GOOGLE_CLIENT_ID).
# Required for Google Sign-In token verification.
GOOGLE_CLIENT_ID=
