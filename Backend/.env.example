# Copy this file to .env and fill in the values.

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=

# JWT auth
JWT_SECRET=
# Legacy single-token lifetime. Since the C-2 cookie migration (§14.F) the
# session is a short access token + a rotating refresh token (see below);
# JWT_EXPIRES_IN is no longer used for sessions.
JWT_EXPIRES_IN=30d

# ── Session cookies (C-2, §14.F) ───────────────────────────────────────────
# Access token lifetime (short) and refresh token lifetime (long). Accept
# values like 15m, 1h, 7d, 30d, or a bare number of milliseconds.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
# Cookie Secure flag. Defaults to ON in production, OFF in dev. Override with
# 'true'/'false' only if you know what you're doing (e.g. HTTPS in local dev).
COOKIE_SECURE=
# SameSite policy. 'lax' is correct for the same-origin proxy deployment
# (Vercel rewrites /api → Railway, so cookies are first-party).
COOKIE_SAMESITE=lax

# Allowed frontend origin(s) for CORS. Comma-separated for multiple
# (e.g. production + Vercel preview URLs). Defaults to http://localhost:5173.
FRONTEND_URL=http://localhost:5173

# Cloudinary (receipt uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth Client ID (same value as the frontend VITE_GOOGLE_CLIENT_ID).
# Required for Google Sign-In token verification.
GOOGLE_CLIENT_ID=

# ── Cloudflare Turnstile (H-8 CAPTCHA, §14.F) ──────────────────────────────
# Free CAPTCHA for signup/login/forgot-password. ENV-GATED: leave blank to
# DISABLE the gate entirely (dev / un-keyed deploys behave as before). Get keys
# at https://dash.cloudflare.com → Turnstile. Set this secret on the backend
# and VITE_TURNSTILE_SITE_KEY on the frontend to switch enforcement on.
TURNSTILE_SECRET=

# ── Observability + ops (§14.G) ────────────────────────────────────────────
# Sentry error monitoring. DSN-GATED — leave blank to disable. PII is scrubbed.
SENTRY_DSN=
# pino log level. Defaults to 'info' in production, 'debug' in dev.
LOG_LEVEL=
# express trust-proxy hop count. Default 1 (Railway); the Vercel→Railway proxy
# path may warrant 2. Accepts a number, 'true', or 'false'.
TRUST_PROXY=
# Backups (scripts/backup.js) — optional S3 offsite copy. See docs/BACKUP.md.
BACKUP_S3_BUCKET=
BACKUP_RETENTION_DAYS=30

# SMTP for transactional email (password reset). Provider-agnostic — works with
# Resend, SendGrid, Mailgun, Gmail, Mailtrap, etc. If left blank, the reset link
# is logged to the server console instead of emailed (fine for local dev).
# Example (Resend): host=smtp.resend.com port=465 user=resend pass=<API key>
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Wedding Expense Tracker <no-reply@yourdomain.com>

# L3 — Gemini Flash AI Coach (Personal-vertical only). Get a free key at
# https://aistudio.google.com/apikey . Without this key set, /api/ai routes
# return a graceful 503 and the frontend shows "AI Coach unavailable".
GEMINI_API_KEY=

# Optional: pick the Gemini model. Defaults to gemini-2.5-flash, which has
# free-tier capacity at the time of writing. If you hit upstream 429s
# with `limit: 0` (Google moved your default model to a paid tier), try:
#   GEMINI_MODEL=gemini-1.5-flash    # older but very reliable free tier
#   GEMINI_MODEL=gemini-2.5-flash    # current default
#   GEMINI_MODEL=gemini-2.0-flash    # requires billing in most regions
GEMINI_MODEL=
